# Salin menjadi .env lalu ubah nilainya.
DATABASE_URL=postgresql+psycopg://claisrox:claisrox@localhost:5432/claisrox
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRE_MINUTES=720

# Akun owner (tier 0) dibuat otomatis saat server pertama kali jalan bila belum ada.
OWNER_USERNAME=owner
OWNER_PASSWORD=ganti-password-ini
OWNER_NAME=Denis

# Folder file tier*.json. Default memakai file yang sama dengan frontend.
TIERS_DIR=../claisrox/js/access/tiers

# Origin frontend yang boleh memanggil API (pisahkan dengan koma).
CORS_ORIGINS=http://localhost:8766,https://n6sport.id
