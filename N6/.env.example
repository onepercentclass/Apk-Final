# N6 Split5 Frontend — Optional runtime overrides.
# Copy to .env and edit. Nothing here is required while the API is disabled.

# The base URL the frontend prefixes when API_ENABLED=true.
# Must match the backend's API_PREFIX (default /api/v1).
# The frontend builds: API_BASE + path  (e.g. https://n6sport.id/api/v1/clients)
API_BASE=https://n6sport.id/api

# Enable the live API. While false, js/core/api.js routes everything to localStorage.
API_ENABLED=false