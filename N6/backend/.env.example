# Copy to backend/.env and edit. Nothing here is read by the dashboards; the
# frontend has its own n6/.env.example.

# ---------------------------------------------------------------- general
APP_NAME=N6 API
ENVIRONMENT=development
DEBUG=true
VERSION=1.0.0
LOG_LEVEL=INFO

# ---------------------------------------------------------------- database
# PostgreSQL. Create the role and database first:
#   createuser n6 --pwprompt
#   createdb n6 --owner n6
DATABASE_URL=postgresql+psycopg://n6:n6@localhost:5432/n6
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------- api
# The frontend builds https://n6sport.id/api + API_PREFIX + '/' + path, so
# leave this alone unless you are mounting the router somewhere else.
API_PREFIX=/api/v1
ROOT_PATH=

# The split frontend runs from any static host while the API is off. These are
# the origins allowed to call the API once you switch it on.
CORS_ORIGINS=["http://localhost:8777", "http://127.0.0.1:8777", "https://n6sport.id"]

# ---------------------------------------------------------------- paths
# Both default to an absolute path derived from this file's location, which is
# what you want. A relative value would resolve against the process working
# directory instead, so only set them to absolute paths.
#
# backend/tiers - one JSON per tier above owner.
# TIERS_DIR=/srv/n6/backend/tiers
#
# Serve index.html and friends from this process. Off by default: the
# dashboards need nothing from FastAPI while they read localStorage.
SERVE_FRONTEND=false
# FRONTEND_DIR=/srv/n6

# ---------------------------------------------------------------- security
# Required in production, at least 32 characters. The app refuses to start
# otherwise.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14

# ------------------------------------------------------------------- seed
# Used only by `python -m app.seed`. Change the passwords before the first
# run that is not on localhost.
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=owner
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin